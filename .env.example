# SANKALP environment template.
#
# Copy this file to `.env` and fill in the real value. `.env` is gitignored and
# must never be committed; this file is committed and must contain placeholders
# ONLY. scripts/check_no_secrets.py fails CI if a live-looking key appears
# anywhere in the tracked tree, including here.
#
#   cmd.exe      copy .env.example .env
#   PowerShell   Copy-Item .env.example .env
#   bash/zsh     cp .env.example .env

# Which provider the LLM client uses. One of: groq | anthropic | cache_only
# `cache_only` replays eval/llm_cache/ and never makes a network call — use it
# in CI and for reproducing published metrics without any credential.
SANKALP_LLM_PROVIDER=groq

# Groq — the only credential this project needs.
# Model: openai/gpt-oss-120b (open weights, by design — see README).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=REPLACE_ME

# The Anthropic provider is kept in core/llm/client.py so the swap stays
# reversible, but it is NOT configured here and no Anthropic key is required.
# To use it, set SANKALP_LLM_PROVIDER=anthropic and add ANTHROPIC_API_KEY.
